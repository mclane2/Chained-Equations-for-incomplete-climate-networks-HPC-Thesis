source("idw.R")
source("ENCE_serial.R")     # sequential updates
source("ENCE_parallel.R")   # synchronous updates (serial execution for now)
rain <- read.csv("simulated_rainfall.csv")
df_miss <- rain
set.seed(222)
sample_rows <- sort(sample(nrow(df_miss), nrow(df_miss) * 0.25))
df_miss[sample_rows, "y"] <- NA
source("ENCE_serial.R")
imp_seq <- ENCE(df_miss, response = "y", max_cycles = 16,
init_method = "idw",
x_name = "east", y_name = "north", t_name = "t",
C = 15000,
transformation = sqrt,
reverse_transformation = function(x) x^2)
rmse_seq <- attr(imp_seq, "rmse_history")
source("ENCE_parallel.R")
imp_sync <- ENCE(df_miss, response = "y", max_cycles = 16,
init_method = "idw",
x_name = "east", y_name = "north", t_name = "t",
C = 15000,
transformation = sqrt,
reverse_transformation = function(x) x^2)
source("idw.R")
source("ENCE_serial.R")     # sequential updates
source("ENCE_parallel.R")   # synchronous updates (serial execution for now)
rain <- read.csv("simulated_rainfall.csv")
rain <- rain[rain$stno <= 50 & rain$t <= 60, ] # Simulating a smaller subset of data for now
df_miss <- rain
set.seed(222)
sample_rows <- sort(sample(nrow(df_miss), nrow(df_miss) * 0.25))
df_miss[sample_rows, "y"] <- NA
source("ENCE_serial.R")
imp_seq <- ENCE(df_miss, response = "y", max_cycles = 16,
init_method = "idw",
x_name = "east", y_name = "north", t_name = "t",
C = 15000,
transformation = sqrt,
reverse_transformation = function(x) x^2)
rmse_seq <- attr(imp_seq, "rmse_history")
source("ENCE_parallel.R")
imp_sync <- ENCE(df_miss, response = "y", max_cycles = 16,
init_method = "idw",
x_name = "east", y_name = "north", t_name = "t",
C = 15000,
transformation = sqrt,
reverse_transformation = function(x) x^2)
rmse_sync <- attr(imp_sync, "rmse_history")
plot(seq_along(rmse_seq), rmse_seq, type = "b", col = "blue", pch = 16,
log = "y",
ylim = range(c(rmse_seq, rmse_sync)),
xlab = "Cycle", ylab = "Internal RMSE (between cycles, log scale)",
main = "Internal convergence: sequential vs synchronous")
lines(seq_along(rmse_sync), rmse_sync, type = "b", col = "red", pch = 17)
legend("topright", legend = c("Sequential", "Synchronous"),
col = c("blue", "red"), pch = c(16, 17), lty = 1)
